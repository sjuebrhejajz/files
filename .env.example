# Database (Neon / Vercel Postgres) — run lib/schema.sql against this once
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signs short-lived login-2FA tickets. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Resend (verification / reset / login-code emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Two-factor authentication is authenticator-app based (TOTP) — no extra env vars needed.

# Stripe (already in use by /api/donate)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 (file uploads AND profile pictures both use this — no separate S3_* vars needed)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: protects the cleanup cron endpoint (Vercel Cron sends this automatically if set)
CRON_SECRET=
